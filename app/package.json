{
  "name": "mocsmith",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "type": "module",
  "description": "A 3D model or a photo → a brick model you can build, in the browser.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5591 --strictPort",
    "build": "vite build && node tools/static-pages.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5592 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build",
    "deploy": "npm run build && wrangler deploy",
    "deploy:ci": "wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "jspdf": "4.2.1",
    "onnxruntime-web": "1.30.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "vite": "8.3.2",
    "wrangler": "4.148.0"
  }
}
