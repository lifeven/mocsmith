# Response headers for the static site on Cloudflare (Workers static assets read this file from
# dist/; it is not served itself). Vite copies it from public/ into dist/ on every build.

# Vite's hashed bundles (page code, three.js, the Web Worker): a new build gives new names,
# so a file at a given name never changes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Everything else (index.html, sample models, thumbnails, availability data, notices) keeps
# Cloudflare's default "revalidate every time", so a deploy shows up on the next load.
# A few safe headers for all:
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
